# Copy this file to .env on the new VM, then fill in secrets there.
# Do not commit the populated .env file.

NODE_ENV=production
PORT=3000
DATA_DIR=/data
TZ_OFFSET_MIN=330

# Configure at least one supported AI provider to enable AI features.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional operational settings
DB_BACKUP_KEEP=7
AI_MIN_REFRESH_GAP_MS=72000000
